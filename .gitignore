# зависимости
node_modules/

# сборка: dist/worker.js и готовая страница — собираются `npm run build`, в релиз идут файлом
dist/
app/app.html

# скриншоты и картинки — собираются `npm run preview` и `npm run art`, картинки для BotFather — в релизе
test/shots/
art/*.png
art/*.svg
# анимация аватара — собирается `npm run avatar`, готовые файлы в релизе
art/*.mp4
art/*.gif
art/frames/
art/framesw/

# локальное окружение Cloudflare и секреты
.wrangler/
.dev.vars
.env*

# прочее
*.log
.DS_Store
Thumbs.db
